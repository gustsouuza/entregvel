VITE_API_URL="https://casamento-api.SEU-SUBDOMINIO.workers.dev"

# URL do site público (o site do convite em si, projeto `public-site/`).
# Usado só pelo botão "Ver Site Real" do painel, para abrir o site de
# verdade em uma nova aba.
VITE_PUBLIC_SITE_URL="https://site.com"

# Precisa ser IGUAL ao valor configurado no Worker com:
#   wrangler secret put ADMIN_TOKEN
# Fica embutido no JS do site admin (visível pra quem inspecionar o bundle) —
# por isso é só uma trava de escrita, não segurança de verdade. Some com o
# Cloudflare Access depois para exigir login por e-mail antes de carregar o site.
VITE_ADMIN_TOKEN="troque-por-um-token-longo-e-aleatorio"

# ─── Evolution API — Disparo automático de WhatsApp ──────────────────────────
# Deixe em branco para usar apenas o modo manual (wa.me, um por um).
#
# COMO CONFIGURAR (guia completo na conversa):
#   1. Crie conta em railway.app
#   2. Suba a imagem Docker: atendai/evolution-api:latest
#   3. Adicione PostgreSQL ao mesmo projeto Railway
#   4. Configure as variáveis de ambiente no Railway (ver guia)
#   5. Crie a instância e escaneie o QR Code com seu celular
#   6. Preencha as 3 variáveis abaixo e faça: npm run build
#
# IMPORTANTE:
#   - Use um número com histórico de uso (não número novo)
#   - Delay de 5–12s entre envios já configurado no código
#   - Recomendado: máx. 250 envios por dia
#   - Mensagem personalizada por convidado já implementada

VITE_EVOLUTION_URL="https://sua-evolution-api.railway.app"
VITE_EVOLUTION_KEY="sua_chave_de_api_aqui"
VITE_EVOLUTION_INSTANCE="nome_da_instancia"
